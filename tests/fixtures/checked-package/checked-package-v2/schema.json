    "FunctionNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "function"}, "semantic_form": {"enum": ["pure_function", "predicate", "recursive_function"]}}}]},
    "ModelNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "model"}, "semantic_form": {"enum": ["model_import", "object_type", "value_type", "variant_type", "record_value_type", "event_type", "state_machine", "process", "persistence_interface", "namespace", "field_declaration", "operation_declaration", "clause_member_declaration", "systems_interface", "systems_part", "systems_port", "systems_connection", "systems_allocation"]}}}]},
    "RelationNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "relation"}, "semantic_form": {"enum": ["relationship", "population", "membership", "causal_relation"]}}}]},
    "StateNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "state"}, "semantic_form": {"enum": ["state_clause", "frame", "transition", "operation_anchor", "snapshot"]}}}]},
    "TemporalNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "temporal"}, "semantic_form": {"enum": ["temporal_clause", "formula", "clock", "window", "activation", "deadline"]}}}]},
    "ProtocolNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "protocol"}, "semantic_form": {"enum": ["protocol_clause", "role", "channel", "queue", "control", "obligation", "compensation"]}}}]},
    "ClaimNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "claim"}, "semantic_form": {"enum": ["verification_claim", "analysis_claim", "hyperproperty", "synthesis_request"]}}}]},
    "CorrespondenceNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "correspondence"}, "semantic_form": {"enum": ["source_locus", "model_correspondence", "binding_role", "profile_correspondence"]}}}]},
    "SemanticNode": {"oneOf": [{"$ref": "#/$defs/ScalarTypeNode"}, {"$ref": "#/$defs/CompositeTypeNode"}, {"$ref": "#/$defs/DomainNode"}, {"$ref": "#/$defs/ValueNode"}, {"$ref": "#/$defs/ExpressionNode"}, {"$ref": "#/$defs/FunctionNode"}, {"$ref": "#/$defs/ModelNode"}, {"$ref": "#/$defs/RelationNode"}, {"$ref": "#/$defs/StateNode"}, {"$ref": "#/$defs/TemporalNode"}, {"$ref": "#/$defs/ProtocolNode"}, {"$ref": "#/$defs/ClaimNode"}, {"$ref": "#/$defs/CorrespondenceNode"}]},
    "NodeProjection": {"type": "object", "required": ["node_id", "schema_version", "node_tag", "semantic_form", "semantic_type", "dependencies", "body"], "properties": {"node_id": {"$ref": "#/$defs/NodeId"}, "schema_version": {"const": "quire.checked-semantic-graph/v2"}, "node_tag": {"enum": ["scalar_type", "composite_type", "bounded_domain", "value", "expression", "function", "model", "relation", "state", "temporal", "protocol", "claim", "correspondence"]}, "semantic_form": {"$ref": "#/$defs/Nonempty"}, "semantic_type": {"$ref": "#/$defs/NodeRef"}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/NodeRef"}}, "recursion_group": {"type": "string", "minLength": 1}, "nominal_identity_preimage": {"$ref": "#/$defs/NominalNodePreimage"}, "declaration": {"$ref": "#/$defs/Declaration"}, "body": {}}, "allOf": [{"$ref": "#/$defs/NominalBindingRules"}, {"$ref": "#/$defs/DeclarationTagRules"}, {"$ref": "#/$defs/BodyBindingRules"}], "additionalProperties": false},
    "SemanticGraph": {"type": "object", "required": ["graph_version", "nodes"], "properties": {"graph_version": {"const": "quire.checked-semantic-graph/v2"}, "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/SemanticNode"}}}, "additionalProperties": false},
    "SourceRegion": {"type": "object", "required": ["source", "start", "end"], "properties": {"source": {"$ref": "#/$defs/RawSourceRef"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "SourceMapEntry": {"type": "object", "required": ["node_id", "role", "ordinal", "regions"], "properties": {"node_id": {"$ref": "#/$defs/NodeRef"}, "role": {"enum": ["declaration", "type", "expression", "anchor", "claim", "generated"]}, "ordinal": {"type": "integer", "minimum": 0}, "regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/SourceRegion"}}}, "additionalProperties": false},
    "Capability": {"type": "object", "required": ["feature", "disposition"], "properties": {"feature": {"$ref": "#/$defs/Nonempty"}, "disposition": {"enum": ["available", "unimplemented", "unsupported"]}}, "additionalProperties": false},
    "Diagnostics": {"type": "object", "required": ["catalog", "entries"], "properties": {"catalog": {"$ref": "#/$defs/DefinitionRef"}, "entries": {"type": "array", "items": {"$ref": "#/$defs/Diagnostic"}}}, "additionalProperties": false},
    "Diagnostic": {"type": "object", "required": ["stage", "code", "cause_tag", "details", "loci"], "properties": {"stage": {"enum": ["source_recognition", "resolution", "type_checking", "package_read", "lowering"]}, "code": {"enum": ["invalid_syntax", "unsupported_construct", "unknown_language", "unknown_edition", "unknown_profile", "unknown_wire", "unknown_required_feature", "missing_import", "missing_declaration", "stale_dependency", "source_digest_mismatch", "ambiguous_declaration", "invalid_package", "invalid_model_binding", "ill_typed", "undefined_expression", "wrong_snapshot", "resource_exhausted", "unimplemented_capability"]}, "cause_tag": {"enum": ["malformed-json", "missing-member", "duplicate-member", "unknown-member", "wrong-value-kind", "invalid-value", "unsupported-wire", "unsupported-feature", "revision-mismatch", "byte-digest-mismatch", "digest-domain-mismatch", "definition-cycle", "conflicting-definition", "incompatible-definition", "feature-set-mismatch", "insufficient-next-charge", "unknown-operation", "operation-class-mismatch", "operation-law-missing", "operation-law-mismatch", "operation-law-unselected", "operation-mode-mismatch", "operation-member-mismatch", "operation-mode-type-mismatch", "operator-ineligible", "stale-node-key", "declaration-nominal-mismatch", "ambiguous-name", "missing-name", "malformed-declaration"]}, "details": {"type": "array", "items": {"$ref": "#/$defs/SemanticTerm"}}, "loci": {"type": "array", "items": {"$ref": "#/$defs/SourceRegion"}}}, "allOf": [{"$ref": "#/$defs/DiagnosticCausePairing"}], "additionalProperties": false},
    "DiagnosticCausePairing": {"allOf": [
      {"if": {"properties": {"cause_tag": {"enum": ["malformed-json", "missing-member", "duplicate-member", "unknown-member", "wrong-value-kind", "invalid-value", "definition-cycle", "conflicting-definition", "incompatible-definition", "feature-set-mismatch", "unknown-operation", "operation-class-mismatch", "operation-law-missing", "operation-law-mismatch", "operation-law-unselected", "operation-mode-mismatch", "operation-member-mismatch", "operation-mode-type-mismatch", "stale-node-key", "declaration-nominal-mismatch"]}}, "required": ["cause_tag"]}, "then": {"properties": {"code": {"const": "invalid_package"}}}},
      {"if": {"properties": {"cause_tag": {"const": "ambiguous-name"}}, "required": ["cause_tag"]}, "then": {"properties": {"code": {"const": "ambiguous_declaration"}}}},
      {"if": {"properties": {"cause_tag": {"const": "unsupported-wire"}}, "required": ["cause_tag"]}, "then": {"properties": {"code": {"const": "unknown_wire"}}}},
      {"if": {"properties": {"cause_tag": {"const": "unsupported-feature"}}, "required": ["cause_tag"]}, "then": {"properties": {"code": {"const": "unknown_required_feature"}}}},
      {"if": {"properties": {"cause_tag": {"enum": ["revision-mismatch", "byte-digest-mismatch", "digest-domain-mismatch"]}}, "required": ["cause_tag"]}, "then": {"properties": {"code": {"enum": ["stale_dependency", "source_digest_mismatch"]}}}},
      {"if": {"properties": {"cause_tag": {"const": "insufficient-next-charge"}}, "required": ["cause_tag"]}, "then": {"properties": {"code": {"const": "resource_exhausted"}}}},
      {"if": {"properties": {"cause_tag": {"const": "operator-ineligible"}}, "required": ["cause_tag"]}, "then": {"properties": {"code": {"const": "ill_typed"}}}},
      {"if": {"properties": {"cause_tag": {"const": "missing-name"}}, "required": ["cause_tag"]}, "then": {"properties": {"code": {"const": "missing_declaration"}}}},
      {"if": {"properties": {"cause_tag": {"const": "malformed-declaration"}}, "required": ["cause_tag"]}, "then": {"properties": {"code": {"const": "invalid_model_binding"}}}}
    ]}
  }
}
