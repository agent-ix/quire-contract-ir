      {"type": "object", "required": ["term", "target"], "properties": {"term": {"const": "reference"}, "target": {"$ref": "#/$defs/NodeRef"}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "operator", "operation", "result_type", "arguments"], "properties": {"term": {"const": "application"}, "operator": {"enum": ["call", "unary", "binary", "conditional", "let", "quantify", "collection", "query", "convert", "pre", "present", "value", "deref", "reaches", "temporal", "protocol_control", "state_transition", "claim"]}, "operation": {"$ref": "#/$defs/Operation"}, "result_type": {"$ref": "#/$defs/NodeRef"}, "arguments": {"type": "array", "items": {"$ref": "#/$defs/SemanticTerm"}}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "members"], "properties": {"term": {"const": "aggregate"}, "members": {"type": "array", "items": {"$ref": "#/$defs/SemanticTerm"}}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "name", "value"], "properties": {"term": {"const": "binding"}, "name": {"$ref": "#/$defs/Nonempty"}, "value": {"$ref": "#/$defs/SemanticTerm"}}, "additionalProperties": false}
    ]},
    "NodeBase": {"type": "object", "required": ["node_id", "schema_version", "node_tag", "semantic_form", "semantic_type", "dependencies", "occurrences", "body"], "properties": {"node_id": {"$ref": "#/$defs/NodeId"}, "schema_version": {"const": "quire.checked-semantic-graph/v2"}, "node_tag": {"enum": ["scalar_type", "composite_type", "bounded_domain", "value", "expression", "function", "model", "relation", "state", "temporal", "protocol", "claim", "correspondence"]}, "semantic_form": {"$ref": "#/$defs/Nonempty"}, "semantic_type": {"$ref": "#/$defs/NodeRef"}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/NodeRef"}}, "occurrences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Occurrence"}}, "recursion_group": {"type": "string", "minLength": 1}, "nominal_identity_preimage": {"$ref": "#/$defs/NominalNodePreimage"}, "declaration": {"$ref": "#/$defs/Declaration"}, "body": {}}, "allOf": [{"$ref": "#/$defs/NominalBindingRules"}, {"$ref": "#/$defs/DeclarationTagRules"}, {"$ref": "#/$defs/DeclarationOccurrenceRule"}, {"$ref": "#/$defs/BodyBindingRules"}], "additionalProperties": false},
    "ScalarTypeNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "scalar_type"}, "semantic_form": {"enum": ["boolean", "integer", "rational", "decimal", "float32", "float64", "text", "dimension", "unit", "enum"]}}}]},
    "CompositeTypeNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "composite_type"}, "semantic_form": {"enum": ["option", "sequence", "set", "bag", "ordered_set", "record", "tuple", "alias", "reference"]}}}]},
    "DomainNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "bounded_domain"}, "semantic_form": {"enum": ["integer_range", "rational_range", "decimal_range", "float_rounding", "text_bounds", "collection_bounds", "model_population"]}}}]},
    "ValueNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "value"}, "semantic_form": {"enum": ["literal", "enum_value", "collection_value", "record_value", "tuple_value", "option_value"]}}}]},
