.op.enum.le","quire.op.enum.gt","quire.op.enum.ge","quire.op.structural.eq","quire.op.structural.ne","quire.op.reference.eq","quire.op.reference.ne","quire.op.reference.upcast","quire.op.numeric.convert","quire.op.numeric.convert_rounding","quire.op.numeric.narrow","quire.op.rational.narrow","quire.op.record.project","quire.op.tuple.project","quire.op.collection.index","quire.op.option.present","quire.op.option.value","quire.op.state.pre","quire.op.control.if","quire.op.control.let","quire.op.collection.sequence","quire.op.collection.set","quire.op.collection.bag","quire.op.collection.ordered_set","quire.op.collection.map","quire.op.collection.filter","quire.op.collection.flat_map","quire.op.collection.flatten","quire.op.collection.fold","quire.op.collection.reduce","quire.op.collection.count","quire.op.collection.sum.integer","quire.op.collection.sum.rational","quire.op.collection.sum.decimal","quire.op.collection.sum.float32","quire.op.collection.sum.float64","quire.op.collection.sum.quantity","quire.op.collection.size","quire.op.collection.contains","quire.op.collection.forall","quire.op.collection.exists","quire.op.collection.convert","quire.op.model.deref","quire.op.model.navigate","quire.op.model.reaches","quire.op.model.lookup","quire.op.model.all_instances","quire.op.model.dispatch_call","quire.op.function.call","quire.op.temporal.clause","quire.op.protocol.control","quire.op.state.transition","quire.op.claim.clause"]},
    "OperationLaw": {"type": "object", "required": ["role", "definition"], "properties": {"role": {"enum": ["integer_division", "ieee_profile", "text_profile", "temporal_profile", "protocol_profile"]}, "definition": {"$ref": "#/$defs/DefinitionRef"}}, "additionalProperties": false},
    "OperationMode": {"oneOf": [
