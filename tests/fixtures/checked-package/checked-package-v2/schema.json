{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quire:checked-package:v2",
  "title": "I04 CheckedPackageArtifactV2",
  "type": "object",
  "required": ["contract_version", "identity_preimage", "package_id", "lock", "semantic_graph", "source_map", "capability_report", "diagnostics"],
  "properties": {
    "contract_version": {"const": "quire.checked-package/v2"},
    "identity_preimage": {"$ref": "#/$defs/IdentityPreimage"},
    "package_id": {"$ref": "#/$defs/PackageId"},
    "lock": {"$ref": "#/$defs/PackageLock"},
    "semantic_graph": {"$ref": "#/$defs/SemanticGraph"},
