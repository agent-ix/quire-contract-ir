{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:quire:checked-package:v2",
  "title": "I04 CheckedPackageArtifactV2",
  "type": "object",
  "required": ["contract_version", "identity_preimage", "package_id", "lock", "semantic_graph", "source_map", "capability_report", "diagnostics"],
  "properties": {
    "contract_version": {"const": "quire.checked-package/v2"},
    "identity_preimage": {"$ref": "#/$defs/IdentityPreimage"},
    "package_id": {"$ref": "#/$defs/PackageId"},
    "lock": {"$ref": "#/$defs/PackageLock"},
    "semantic_graph": {"$ref": "#/$defs/SemanticGraph"},
    "source_map": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/SourceMapEntry"}},
    "capability_report": {"type": "array", "items": {"$ref": "#/$defs/Capability"}},
    "diagnostics": {"$ref": "#/$defs/Diagnostics"}
  },
  "additionalProperties": false,
  "$defs": {
    "Nonempty": {"type": "string", "minLength": 1},
    "HexDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Revision": {"type": "object", "required": ["namespace", "value"], "properties": {"namespace": {"$ref": "#/$defs/Nonempty"}, "value": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "SemanticDigest": {"type": "object", "required": ["domain", "algorithm", "digest"], "properties": {"domain": {"enum": ["quire.package.semantic/v2", "quire.checked-semantic-node/v1", "quire.contract-ir.semantic/v1"]}, "algorithm": {"const": "sha256"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "PackageId": {"type": "object", "required": ["domain", "algorithm", "digest"], "properties": {"domain": {"const": "quire.package.semantic/v2"}, "algorithm": {"const": "sha256"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "RawSourceRef": {"type": "object", "required": ["authority", "identity", "revision", "digest_domain", "digest"], "properties": {"authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}, "revision": {"$ref": "#/$defs/Revision"}, "digest_domain": {"const": "quire.source.bytes/v1"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "DefinitionRef": {"type": "object", "required": ["authority", "identity", "revision", "digest_domain", "digest"], "properties": {"authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}, "revision": {"$ref": "#/$defs/Revision"}, "digest_domain": {"const": "quire.definition.bytes/v1"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "ModelRef": {"type": "object", "required": ["identity", "version", "digest_domain", "digest"], "properties": {"identity": {"$ref": "#/$defs/Nonempty"}, "version": {"$ref": "#/$defs/Nonempty"}, "digest_domain": {"const": "sha256-jcs"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "Selection": {"type": "object", "required": ["role", "definition"], "properties": {"role": {"enum": ["language", "edition", "profile", "dependency", "binding_contract", "temporal_profile", "protocol_profile"]}, "definition": {"$ref": "#/$defs/DefinitionRef"}}, "additionalProperties": false},
    "PackageLock": {"type": "object", "required": ["sources", "edition", "profile_selections", "definition_selections", "model_selections", "required_features", "dependency_selections"], "properties": {"sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/RawSourceRef"}}, "edition": {"$ref": "#/$defs/Selection"}, "profile_selections": {"type": "array", "items": {"$ref": "#/$defs/Selection"}}, "definition_selections": {"type": "array", "items": {"$ref": "#/$defs/DefinitionRef"}}, "model_selections": {"type": "array", "items": {"$ref": "#/$defs/ModelRef"}, "uniqueItems": true}, "required_features": {"type": "array", "items": {"$ref": "#/$defs/Nonempty"}, "uniqueItems": true}, "dependency_selections": {"type": "array", "items": {"$ref": "#/$defs/Selection"}}}, "additionalProperties": false},
    "IdentityPreimage": {"type": "object", "required": ["version", "edition", "profile_selections", "definition_selections", "model_selections", "required_features", "dependency_selections", "identity_projection"], "properties": {"version": {"const": "quire.checked-package-id/v2"}, "edition": {"$ref": "#/$defs/Selection"}, "profile_selections": {"type": "array", "items": {"$ref": "#/$defs/Selection"}}, "definition_selections": {"type": "array", "items": {"$ref": "#/$defs/DefinitionRef"}}, "model_selections": {"type": "array", "items": {"$ref": "#/$defs/ModelRef"}, "uniqueItems": true}, "required_features": {"type": "array", "items": {"$ref": "#/$defs/Nonempty"}, "uniqueItems": true}, "dependency_selections": {"type": "array", "items": {"$ref": "#/$defs/Selection"}}, "identity_projection": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/NodeProjection"}}}, "additionalProperties": false},
    "NodeId": {"type": "object", "required": ["domain", "digest"], "properties": {"domain": {"const": "quire.checked-semantic-node/v1"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "NodeRef": {"$ref": "#/$defs/NodeId"},
    "Identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "QualifiedName": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Identifier"}},
    "SourceOwner": {"type": "object", "required": ["kind", "authority", "identity"], "properties": {"kind": {"const": "source"}, "authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "DefinitionOwner": {"type": "object", "required": ["kind", "authority", "identity"], "properties": {"kind": {"const": "definition"}, "authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "ModelOwner": {"type": "object", "required": ["kind", "identity", "node"], "properties": {"kind": {"const": "model"}, "identity": {"$ref": "#/$defs/Nonempty"}, "node": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "NominalOwner": {"oneOf": [{"$ref": "#/$defs/SourceOwner"}, {"$ref": "#/$defs/DefinitionOwner"}, {"$ref": "#/$defs/ModelOwner"}]},
    "IntegerString": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"},
    "PositiveIntegerString": {"type": "string", "pattern": "^[1-9][0-9]*$"},
    "Rational": {"type": "object", "required": ["numerator", "denominator"], "properties": {"numerator": {"$ref": "#/$defs/IntegerString"}, "denominator": {"$ref": "#/$defs/PositiveIntegerString"}}, "additionalProperties": false},
    "DimensionTerm": {"type": "object", "required": ["dimension_node_id", "exponent"], "properties": {"dimension_node_id": {"$ref": "#/$defs/NodeId"}, "exponent": {"$ref": "#/$defs/IntegerString"}}, "additionalProperties": false},
    "EnumDeclarationPreimage": {"type": "object", "required": ["version", "owner", "qualified_declaration", "ordered", "members"], "properties": {"version": {"const": "quire.enum-declaration-node/v1"}, "owner": {"$ref": "#/$defs/NominalOwner"}, "qualified_declaration": {"$ref": "#/$defs/QualifiedName"}, "ordered": {"type": "boolean"}, "members": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/Identifier"}}}, "additionalProperties": false},
    "EnumMemberPreimage": {"type": "object", "required": ["version", "declaration_node_id", "case"], "properties": {"version": {"const": "quire.enum-member-node/v1"}, "declaration_node_id": {"$ref": "#/$defs/NodeId"}, "case": {"$ref": "#/$defs/Identifier"}}, "additionalProperties": false},
    "DimensionPreimage": {"type": "object", "required": ["version", "owner", "qualified_declaration", "terms"], "properties": {"version": {"const": "quire.dimension-node/v1"}, "owner": {"$ref": "#/$defs/NominalOwner"}, "qualified_declaration": {"$ref": "#/$defs/QualifiedName"}, "terms": {"type": "array", "items": {"$ref": "#/$defs/DimensionTerm"}}}, "additionalProperties": false},
    "UnitPreimage": {"type": "object", "required": ["version", "owner", "qualified_declaration", "dimension_node_id", "target_unit_node_id", "scale", "offset"], "properties": {"version": {"const": "quire.unit-node/v1"}, "owner": {"$ref": "#/$defs/NominalOwner"}, "qualified_declaration": {"$ref": "#/$defs/QualifiedName"}, "dimension_node_id": {"$ref": "#/$defs/NodeId"}, "target_unit_node_id": {"oneOf": [{"$ref": "#/$defs/NodeId"}, {"type": "null"}]}, "scale": {"$ref": "#/$defs/Rational"}, "offset": {"$ref": "#/$defs/Rational"}}, "additionalProperties": false},
    "NominalNodePreimage": {"oneOf": [{"$ref": "#/$defs/EnumDeclarationPreimage"}, {"$ref": "#/$defs/EnumMemberPreimage"}, {"$ref": "#/$defs/DimensionPreimage"}, {"$ref": "#/$defs/UnitPreimage"}]},
    "NominalBindingRules": {"allOf": [
      {"if": {"properties": {"node_tag": {"const": "scalar_type"}, "semantic_form": {"const": "enum"}}, "required": ["node_tag", "semantic_form"]}, "then": {"required": ["nominal_identity_preimage"], "properties": {"nominal_identity_preimage": {"$ref": "#/$defs/EnumDeclarationPreimage"}}}},
      {"if": {"properties": {"node_tag": {"const": "value"}, "semantic_form": {"const": "enum_value"}}, "required": ["node_tag", "semantic_form"]}, "then": {"required": ["nominal_identity_preimage"], "properties": {"nominal_identity_preimage": {"$ref": "#/$defs/EnumMemberPreimage"}}}},
      {"if": {"properties": {"node_tag": {"const": "scalar_type"}, "semantic_form": {"const": "dimension"}}, "required": ["node_tag", "semantic_form"]}, "then": {"required": ["nominal_identity_preimage"], "properties": {"nominal_identity_preimage": {"$ref": "#/$defs/DimensionPreimage"}}}},
      {"if": {"properties": {"node_tag": {"const": "scalar_type"}, "semantic_form": {"const": "unit"}}, "required": ["node_tag", "semantic_form"]}, "then": {"required": ["nominal_identity_preimage"], "properties": {"nominal_identity_preimage": {"$ref": "#/$defs/UnitPreimage"}}}},
      {"if": {"not": {"anyOf": [
        {"properties": {"node_tag": {"const": "scalar_type"}, "semantic_form": {"const": "enum"}}, "required": ["node_tag", "semantic_form"]},
        {"properties": {"node_tag": {"const": "value"}, "semantic_form": {"const": "enum_value"}}, "required": ["node_tag", "semantic_form"]},
        {"properties": {"node_tag": {"const": "scalar_type"}, "semantic_form": {"const": "dimension"}}, "required": ["node_tag", "semantic_form"]},
        {"properties": {"node_tag": {"const": "scalar_type"}, "semantic_form": {"const": "unit"}}, "required": ["node_tag", "semantic_form"]}
      ]}}, "then": {"not": {"required": ["nominal_identity_preimage"]}}}
    ]},
    "Occurrence": {"type": "object", "required": ["role", "ordinal"], "properties": {"role": {"enum": ["declaration", "type", "expression", "anchor", "claim", "generated"]}, "ordinal": {"type": "integer", "minimum": 0}}, "additionalProperties": false},
    "SemanticTerm": {"oneOf": [
      {"type": "object", "required": ["term", "value_kind", "value"], "properties": {"term": {"const": "literal"}, "value_kind": {"enum": ["boolean", "integer", "rational", "decimal", "float32_bits", "float64_bits", "text", "enum", "none"]}, "value": {"type": ["boolean", "string", "integer", "null"]}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "target"], "properties": {"term": {"const": "reference"}, "target": {"$ref": "#/$defs/NodeRef"}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "operator", "arguments"], "properties": {"term": {"const": "application"}, "operator": {"enum": ["call", "unary", "binary", "conditional", "let", "quantify", "collection", "query", "convert", "pre", "present", "value", "deref", "reaches", "temporal", "protocol_control", "state_transition", "claim"]}, "arguments": {"type": "array", "items": {"$ref": "#/$defs/SemanticTerm"}}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "members"], "properties": {"term": {"const": "aggregate"}, "members": {"type": "array", "items": {"$ref": "#/$defs/SemanticTerm"}}}, "additionalProperties": false},
      {"type": "object", "required": ["term", "name", "value"], "properties": {"term": {"const": "binding"}, "name": {"$ref": "#/$defs/Nonempty"}, "value": {"$ref": "#/$defs/SemanticTerm"}}, "additionalProperties": false}
    ]},
    "NodeBase": {"type": "object", "required": ["node_id", "schema_version", "node_tag", "semantic_form", "semantic_type", "dependencies", "occurrences", "body"], "properties": {"node_id": {"$ref": "#/$defs/NodeId"}, "schema_version": {"const": "quire.checked-semantic-graph/v2"}, "node_tag": {"enum": ["scalar_type", "composite_type", "bounded_domain", "value", "expression", "function", "model", "relation", "state", "temporal", "protocol", "claim", "correspondence"]}, "semantic_form": {"$ref": "#/$defs/Nonempty"}, "semantic_type": {"$ref": "#/$defs/NodeRef"}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/NodeRef"}}, "occurrences": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Occurrence"}}, "recursion_group": {"type": "string", "minLength": 1}, "nominal_identity_preimage": {"$ref": "#/$defs/NominalNodePreimage"}, "body": {"$ref": "#/$defs/SemanticTerm"}}, "allOf": [{"$ref": "#/$defs/NominalBindingRules"}], "additionalProperties": false},
    "ScalarTypeNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "scalar_type"}, "semantic_form": {"enum": ["boolean", "integer", "rational", "decimal", "float32", "float64", "text", "dimension", "unit", "enum"]}}}]},
    "CompositeTypeNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "composite_type"}, "semantic_form": {"enum": ["option", "sequence", "set", "bag", "ordered_set", "record", "tuple", "alias", "reference"]}}}]},
    "DomainNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "bounded_domain"}, "semantic_form": {"enum": ["integer_range", "rational_range", "decimal_range", "float_rounding", "text_bounds", "collection_bounds", "model_population"]}}}]},
    "ValueNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "value"}, "semantic_form": {"enum": ["literal", "enum_value", "collection_value", "record_value", "tuple_value", "option_value"]}}}]},
    "ExpressionNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "expression"}, "semantic_form": {"enum": ["reference", "call", "unary", "binary", "conditional", "let", "quantify", "conversion", "query", "pre_read", "presence_read", "deref", "reachability"]}}}]},
    "FunctionNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "function"}, "semantic_form": {"enum": ["pure_function", "predicate", "recursive_function"]}}}]},
    "ModelNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "model"}, "semantic_form": {"enum": ["model_import", "model_type", "model_declaration"]}}}]},
    "RelationNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "relation"}, "semantic_form": {"enum": ["relationship", "population", "membership", "causal_relation"]}}}]},
    "StateNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "state"}, "semantic_form": {"enum": ["state_clause", "frame", "transition", "operation_anchor", "snapshot"]}}}]},
    "TemporalNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "temporal"}, "semantic_form": {"enum": ["temporal_clause", "formula", "clock", "window", "activation", "deadline"]}}}]},
    "ProtocolNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "protocol"}, "semantic_form": {"enum": ["protocol_clause", "role", "channel", "queue", "control", "obligation", "compensation"]}}}]},
    "ClaimNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "claim"}, "semantic_form": {"enum": ["verification_claim", "analysis_claim", "hyperproperty", "synthesis_request"]}}}]},
    "CorrespondenceNode": {"allOf": [{"$ref": "#/$defs/NodeBase"}, {"properties": {"node_tag": {"const": "correspondence"}, "semantic_form": {"enum": ["source_locus", "model_correspondence", "binding_role", "profile_correspondence"]}}}]},
    "SemanticNode": {"oneOf": [{"$ref": "#/$defs/ScalarTypeNode"}, {"$ref": "#/$defs/CompositeTypeNode"}, {"$ref": "#/$defs/DomainNode"}, {"$ref": "#/$defs/ValueNode"}, {"$ref": "#/$defs/ExpressionNode"}, {"$ref": "#/$defs/FunctionNode"}, {"$ref": "#/$defs/ModelNode"}, {"$ref": "#/$defs/RelationNode"}, {"$ref": "#/$defs/StateNode"}, {"$ref": "#/$defs/TemporalNode"}, {"$ref": "#/$defs/ProtocolNode"}, {"$ref": "#/$defs/ClaimNode"}, {"$ref": "#/$defs/CorrespondenceNode"}]},
    "NodeProjection": {"type": "object", "required": ["node_id", "schema_version", "node_tag", "semantic_form", "semantic_type", "dependencies", "body"], "properties": {"node_id": {"$ref": "#/$defs/NodeId"}, "schema_version": {"const": "quire.checked-semantic-graph/v2"}, "node_tag": {"enum": ["scalar_type", "composite_type", "bounded_domain", "value", "expression", "function", "model", "relation", "state", "temporal", "protocol", "claim", "correspondence"]}, "semantic_form": {"$ref": "#/$defs/Nonempty"}, "semantic_type": {"$ref": "#/$defs/NodeRef"}, "dependencies": {"type": "array", "items": {"$ref": "#/$defs/NodeRef"}}, "recursion_group": {"type": "string", "minLength": 1}, "nominal_identity_preimage": {"$ref": "#/$defs/NominalNodePreimage"}, "body": {"$ref": "#/$defs/SemanticTerm"}}, "allOf": [{"$ref": "#/$defs/NominalBindingRules"}], "additionalProperties": false},
    "SemanticGraph": {"type": "object", "required": ["graph_version", "nodes"], "properties": {"graph_version": {"const": "quire.checked-semantic-graph/v2"}, "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/SemanticNode"}}}, "additionalProperties": false},
    "SourceRegion": {"type": "object", "required": ["source", "start", "end"], "properties": {"source": {"$ref": "#/$defs/RawSourceRef"}, "start": {"type": "integer", "minimum": 0}, "end": {"type": "integer", "minimum": 1}}, "additionalProperties": false},
    "SourceMapEntry": {"type": "object", "required": ["node_id", "role", "ordinal", "regions"], "properties": {"node_id": {"$ref": "#/$defs/NodeRef"}, "role": {"enum": ["declaration", "type", "expression", "anchor", "claim", "generated"]}, "ordinal": {"type": "integer", "minimum": 0}, "regions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/SourceRegion"}}}, "additionalProperties": false},
    "Capability": {"type": "object", "required": ["feature", "disposition"], "properties": {"feature": {"$ref": "#/$defs/Nonempty"}, "disposition": {"enum": ["available", "unimplemented", "unsupported"]}}, "additionalProperties": false},
    "Diagnostics": {"type": "object", "required": ["catalog", "entries"], "properties": {"catalog": {"$ref": "#/$defs/DefinitionRef"}, "entries": {"type": "array", "items": {"$ref": "#/$defs/Diagnostic"}}}, "additionalProperties": false},
    "Diagnostic": {"type": "object", "required": ["stage", "code", "cause_tag", "details", "loci"], "properties": {"stage": {"enum": ["source_recognition", "resolution", "type_checking", "package_read", "lowering"]}, "code": {"enum": ["invalid_syntax", "unsupported_construct", "unknown_language", "unknown_edition", "unknown_profile", "unknown_wire", "unknown_required_feature", "missing_import", "missing_declaration", "stale_dependency", "source_digest_mismatch", "ambiguous_declaration", "invalid_package", "invalid_model_binding", "ill_typed", "undefined_expression", "wrong_snapshot", "resource_exhausted", "unimplemented_capability"]}, "cause_tag": {"enum": ["malformed-json", "missing-member", "duplicate-member", "unknown-member", "wrong-value-kind", "invalid-value", "unsupported-wire", "unsupported-feature", "revision-mismatch", "byte-digest-mismatch", "digest-domain-mismatch", "definition-cycle", "conflicting-definition", "incompatible-definition", "feature-set-mismatch", "insufficient-next-charge"]}, "details": {"type": "array", "items": {"$ref": "#/$defs/SemanticTerm"}}, "loci": {"type": "array", "items": {"$ref": "#/$defs/SourceRegion"}}}, "additionalProperties": false}
  }
}
