    "diagnostics": {"$ref": "#/$defs/Diagnostics"}
  },
  "additionalProperties": false,
  "$defs": {
    "Nonempty": {"type": "string", "minLength": 1},
    "HexDigest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "Revision": {"type": "object", "required": ["namespace", "value"], "properties": {"namespace": {"$ref": "#/$defs/Nonempty"}, "value": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "SemanticDigest": {"type": "object", "required": ["domain", "algorithm", "digest"], "properties": {"domain": {"enum": ["quire.package.semantic/v2", "quire.checked-semantic-node/v1", "quire.contract-ir.semantic/v1"]}, "algorithm": {"const": "sha256"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "PackageId": {"type": "object", "required": ["domain", "algorithm", "digest"], "properties": {"domain": {"const": "quire.package.semantic/v2"}, "algorithm": {"const": "sha256"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "RawSourceRef": {"type": "object", "required": ["authority", "identity", "revision", "digest_domain", "digest"], "properties": {"authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}, "revision": {"$ref": "#/$defs/Revision"}, "digest_domain": {"const": "quire.source.bytes/v1"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "DefinitionRef": {"type": "object", "required": ["authority", "identity", "revision", "digest_domain", "digest"], "properties": {"authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}, "revision": {"$ref": "#/$defs/Revision"}, "digest_domain": {"const": "quire.definition.bytes/v1"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "ModelRef": {"type": "object", "required": ["identity", "version", "digest_domain", "digest"], "properties": {"identity": {"$ref": "#/$defs/Nonempty"}, "version": {"$ref": "#/$defs/Nonempty"}, "digest_domain": {"const": "sha256-jcs"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "Selection": {"type": "object", "required": ["role", "definition"], "properties": {"role": {"enum": ["language", "edition", "profile", "dependency", "binding_contract", "temporal_profile", "protocol_profile"]}, "definition": {"$ref": "#/$defs/DefinitionRef"}}, "additionalProperties": false},
    "PackageLock": {"type": "object", "required": ["sources", "edition", "profile_selections", "definition_selections", "model_selections", "required_features", "dependency_selections"], "properties": {"sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/RawSourceRef"}}, "edition": {"$ref": "#/$defs/Selection"}, "profile_selections": {"type": "array", "items": {"$ref": "#/$defs/Selection"}}, "definition_selections": {"type": "array", "items": {"$ref": "#/$defs/DefinitionRef"}}, "model_selections": {"type": "array", "items": {"$ref": "#/$defs/ModelRef"}, "uniqueItems": true}, "required_features": {"type": "array", "items": {"$ref": "#/$defs/Nonempty"}, "uniqueItems": true}, "dependency_selections": {"type": "array", "items": {"$ref": "#/$defs/Selection"}}}, "additionalProperties": false},
    "IdentityPreimage": {"type": "object", "required": ["version", "edition", "profile_selections", "definition_selections", "model_selections", "required_features", "dependency_selections", "identity_projection"], "properties": {"version": {"const": "quire.checked-package-id/v2"}, "edition": {"$ref": "#/$defs/Selection"}, "profile_selections": {"type": "array", "items": {"$ref": "#/$defs/Selection"}}, "definition_selections": {"type": "array", "items": {"$ref": "#/$defs/DefinitionRef"}}, "model_selections": {"type": "array", "items": {"$ref": "#/$defs/ModelRef"}, "uniqueItems": true}, "required_features": {"type": "array", "items": {"$ref": "#/$defs/Nonempty"}, "uniqueItems": true}, "dependency_selections": {"type": "array", "items": {"$ref": "#/$defs/Selection"}}, "identity_projection": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/NodeProjection"}}}, "additionalProperties": false},
    "NodeId": {"type": "object", "required": ["domain", "digest"], "properties": {"domain": {"const": "quire.checked-semantic-node/v1"}, "digest": {"$ref": "#/$defs/HexDigest"}}, "additionalProperties": false},
    "NodeRef": {"$ref": "#/$defs/NodeId"},
    "Identifier": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
    "QualifiedName": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/Identifier"}},
    "Declaration": {"type": "object", "required": ["qualified_name"], "properties": {"qualified_name": {"$ref": "#/$defs/QualifiedName"}}, "additionalProperties": false},
    "FrameBody": {"type": "object", "required": ["term", "modifies", "creates", "deletes"], "properties": {"term": {"const": "frame"}, "modifies": {"type": "array", "items": {"$ref": "#/$defs/NodeRef"}, "uniqueItems": true}, "creates": {"type": "array", "items": {"$ref": "#/$defs/NodeRef"}, "uniqueItems": true}, "deletes": {"type": "array", "items": {"$ref": "#/$defs/NodeRef"}, "uniqueItems": true}}, "additionalProperties": false},
    "BodyBindingRules": {"if": {"properties": {"node_tag": {"const": "state"}, "semantic_form": {"const": "frame"}}, "required": ["node_tag", "semantic_form"]}, "then": {"properties": {"body": {"$ref": "#/$defs/FrameBody"}}}, "else": {"properties": {"body": {"$ref": "#/$defs/SemanticTerm"}}}},
    "DeclarationTagRules": {"if": {"anyOf": [{"properties": {"node_tag": {"enum": ["expression", "relation", "state", "temporal", "correspondence"]}}, "required": ["node_tag"]}, {"properties": {"node_tag": {"const": "value"}, "semantic_form": {"const": "enum_value"}}, "required": ["node_tag", "semantic_form"]}]}, "then": {"not": {"required": ["declaration"]}}},
    "DeclarationOccurrenceRule": {"if": {"properties": {"node_tag": {"enum": ["scalar_type", "composite_type", "bounded_domain", "value", "function", "model", "protocol", "claim"]}, "semantic_form": {"not": {"const": "enum_value"}}}, "required": ["node_tag", "semantic_form"]}, "then": {"if": {"properties": {"occurrences": {"contains": {"properties": {"role": {"const": "declaration"}}, "required": ["role"]}}}}, "then": {"required": ["declaration"]}, "else": {"not": {"required": ["declaration"]}}}},
    "SourceOwner": {"type": "object", "required": ["kind", "authority", "identity"], "properties": {"kind": {"const": "source"}, "authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "DefinitionOwner": {"type": "object", "required": ["kind", "authority", "identity"], "properties": {"kind": {"const": "definition"}, "authority": {"$ref": "#/$defs/Nonempty"}, "identity": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "ModelOwner": {"type": "object", "required": ["kind", "identity", "node"], "properties": {"kind": {"const": "model"}, "identity": {"$ref": "#/$defs/Nonempty"}, "node": {"$ref": "#/$defs/Nonempty"}}, "additionalProperties": false},
    "NominalOwner": {"oneOf": [{"$ref": "#/$defs/SourceOwner"}, {"$ref": "#/$defs/DefinitionOwner"}, {"$ref": "#/$defs/ModelOwner"}]},
    "IntegerString": {"type": "string", "pattern": "^(0|-?[1-9][0-9]*)$"},
    "PositiveIntegerString": {"type": "string", "pattern": "^[1-9][0-9]*$"},
