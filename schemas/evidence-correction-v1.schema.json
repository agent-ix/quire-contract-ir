{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://agent-ix.github.io/quire-contract-ir/schemas/evidence-correction-v1.schema.json",
  "title": "Append-only correction to a retained evidence claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "recordedAt",
    "repository",
    "affectedClaims",
    "correctedStatus",
    "findingRefs",
    "basis",
    "immutability",
    "decisionEffect"
  ],
  "properties": {
    "schemaVersion": {"const": "quire.evidence-correction/v1"},
    "recordId": {"type": "string", "pattern": "^COR-[0-9]{3}$"},
    "recordedAt": {"type": "string", "format": "date-time"},
    "repository": {"type": "string", "format": "uri"},
    "affectedClaims": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["record", "claim", "location"],
        "properties": {
          "record": {"type": "string", "minLength": 1},
          "claim": {"type": "string", "minLength": 1},
          "location": {"type": "string", "format": "uri"}
        }
      }
    },
    "correctedStatus": {"enum": ["fail", "inconclusive", "skipped"]},
    "findingRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "format": "uri"}
    },
    "basis": {"type": "string", "minLength": 1},
    "immutability": {"type": "string", "minLength": 1},
    "decisionEffect": {"type": "string", "minLength": 1}
  }
}
