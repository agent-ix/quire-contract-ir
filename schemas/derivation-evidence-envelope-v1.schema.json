{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/agent-ix/quire-contract-ir/schemas/derivation-evidence-envelope-v1.schema.json",
  "title": "Quire derivation and evidence envelope v1",
  "description": "PGM-01 common identity envelope. SPDX-License-Identifier: MIT OR Apache-2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordId",
    "recordedAt",
    "producer",
    "inputs",
    "backend",
    "outputs",
    "parametersDigest",
    "environment",
    "provenance",
    "result"
  ],
  "properties": {
    "schemaVersion": {
      "const": "quire.derivation-evidence/v1"
    },
    "recordId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "recordedAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "$ref": "#/definitions/producer"
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/artifactInput"
      }
    },
    "backend": {
      "oneOf": [
        {
          "$ref": "#/definitions/noBackend"
        },
        {
          "$ref": "#/definitions/backend"
        }
      ]
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/artifactOutput"
      }
    },
    "parametersDigest": {
      "$ref": "#/definitions/digest"
    },
    "environment": {
      "$ref": "#/definitions/environment"
    },
    "provenance": {
      "$ref": "#/definitions/provenance"
    },
    "result": {
      "$ref": "#/definitions/result"
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+$"
      }
    }
  },
  "definitions": {
    "digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": {
          "const": "sha256"
        },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "schemaIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "digest"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "digest": {
          "$ref": "#/definitions/digest"
        }
      }
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "sourceRevision", "executableDigest", "invocation"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "executableDigest": {
          "$ref": "#/definitions/digest"
        },
        "invocation": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "artifactInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "uri", "mediaType", "schema", "contentDigest"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri-reference"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "$ref": "#/definitions/schemaIdentity"
        },
        "contentDigest": {
          "$ref": "#/definitions/digest"
        }
      }
    },
    "artifactOutput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "uri", "mediaType", "schema", "contentDigest"],
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri-reference"
        },
        "mediaType": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "$ref": "#/definitions/schemaIdentity"
        },
        "contentDigest": {
          "$ref": "#/definitions/digest"
        }
      }
    },
    "noBackend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reason"],
      "properties": {
        "kind": {
          "const": "none"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "name", "version", "executableDigest", "configurationDigest"],
      "properties": {
        "kind": {
          "enum": ["engine", "tool"]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "executableDigest": {
          "$ref": "#/definitions/digest"
        },
        "configurationDigest": {
          "$ref": "#/definitions/digest"
        }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetTriple", "operatingSystem", "toolchain", "dependenciesDigest"],
      "properties": {
        "targetTriple": {
          "type": "string",
          "minLength": 1
        },
        "operatingSystem": {
          "type": "string",
          "minLength": 1
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "dependenciesDigest": {
          "$ref": "#/definitions/digest"
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "sourceRevision", "candidateRevision", "contributionMethod", "reviewers"],
      "properties": {
        "repository": {
          "type": "string",
          "format": "uri"
        },
        "sourceRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "candidateRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40,64}$"
        },
        "contributionMethod": {
          "enum": ["human", "agent-assisted", "generated", "mixed"]
        },
        "reviewers": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^@[A-Za-z0-9-]+$"
          }
        }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "summary", "requirementRefs"],
      "properties": {
        "status": {
          "enum": ["conclusive", "inconclusive", "unsupported", "rejected", "timed-out", "pending", "error"]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "requirementRefs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
